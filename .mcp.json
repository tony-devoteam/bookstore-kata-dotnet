{
  "mcpServers": {
    "codegraph": {
      "type": "stdio",
      "command": "codegraph",
      "args": ["serve", "--mcp"]
    },
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "X-MCP-Toolsets": "issues"
      }
    },
    "graphify": {
      "type": "stdio",
      "command": "graphify",
      "args": [".", "--mcp"]
    }
  }
}
